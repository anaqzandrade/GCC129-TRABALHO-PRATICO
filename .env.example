# Opcional: copie para .env para trocar as credenciais.
# Sem .env, o docker-compose.yml usa estes mesmos valores padrão.
POSTGRES_USER=ravita
POSTGRES_PASSWORD=ravita
RABBITMQ_USER=ravita
RABBITMQ_PASSWORD=ravita
# Chave HS256 dos tokens do API Gateway (pelo menos 32 caracteres).
JWT_SECRET=ravita-dev-secret-troque-no-env-2026
# Chave da API do Gemini para o assistant-service (Google AI Studio, nível gratuito).
# Coloque a chave só no .env, que não vai para o git. Vazia: o assistente responde pelo fallback.
GOOGLE_API_KEY=
