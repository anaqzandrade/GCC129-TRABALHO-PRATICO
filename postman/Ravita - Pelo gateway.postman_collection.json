    {
      "name": "3. Portal",
      "item": [
        {
          "name": "Publicar oferta (doador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodCategory\": \"VEGETABLES\",\n  \"description\": \"Hortaliças variadas\",\n  \"quantity\": 30,\n  \"unit\": \"KG\",\n  \"availableFrom\": \"{{inicio}}\",\n  \"availableUntil\": \"{{fim}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = n => String(n).padStart(2, \"0\");",
                  "const iso = d => { const off = -d.getTimezoneOffset(), a = Math.abs(off);",
                  "  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}${off >= 0 ? \"+\" : \"-\"}${pad(Math.floor(a / 60))}:${pad(a % 60)}`; };",
                  "const agora = new Date();",
                  "pm.collectionVariables.set(\"inicio\", iso(agora));",
                  "pm.collectionVariables.set(\"fim\", iso(new Date(agora.getTime() + 6 * 3600 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test(\"donorId vem do token\", () => pm.expect(o.donorId).to.eql(pm.collectionVariables.get(\"doadorId\")));",
                  "pm.collectionVariables.set(\"ofertaId\", o.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: instituição publicando oferta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodCategory\": \"VEGETABLES\",\n  \"description\": \"Pães\",\n  \"quantity\": 30,\n  \"unit\": \"KG\",\n  \"availableFrom\": \"{{inicio}}\",\n  \"availableUntil\": \"{{fim}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 FORBIDDEN\", () => {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().code).to.eql(\"FORBIDDEN\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Minhas ofertas (doador)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/my-offers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"a oferta publicada está na lista\", () => pm.expect(pm.response.json().items.map(o => o.id)).to.include(pm.collectionVariables.get(\"ofertaId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalhe da oferta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers/{{ofertaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"link para iniciar a redistribuição\", () => pm.expect(pm.response.json()._links).to.have.property(\"start-redistribution\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar demanda (instituição)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/demands",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodCategory\": \"VEGETABLES\",\n  \"desiredQuantity\": 20,\n  \"unit\": \"KG\",\n  \"city\": \"Lavras\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"demandaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ofertas compatíveis com a demanda",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/demands/{{demandaId}}/matches"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. CQRS",
      "description": "GET /portal/v1/offers lê a tabela available_offers_read, atualizada pelos eventos do outbox.",
      "item": [
        {
          "name": "Oferta no modelo de leitura",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers?category=VEGETABLES&size=100"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// dá tempo para o outbox publicar e a projeção aplicar o evento",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const oferta = pm.response.json().items.find(o => o.id === pm.collectionVariables.get(\"ofertaId\"));",
                  "pm.test(\"a oferta criada aparece na leitura\", () => pm.expect(oferta).to.be.an(\"object\"));",
                  "pm.test(\"o Portal esconde os campos internos da projeção\", () => pm.expect(oferta).to.not.have.property(\"lastEvent\"));",
                  "pm.test(\"nome do doador desnormalizado\", () => pm.expect(oferta.donorName).to.eql(\"Mercado Central\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. SAGA (caminho feliz)",
      "item": [
        {
          "name": "Iniciar redistribuição (instituição)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-saga-ok"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/redistributions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"{{ofertaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "O Portal BFF monta o pedido da SAGA: endereço de coleta da oferta e de entrega da instituição."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"coleta agendada\", () => pm.expect(r.status).to.eql(\"LOGISTICS_PENDING\"));",
                  "pm.collectionVariables.set(\"redistribuicaoId\", r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Acompanhar no Portal",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/redistributions/{{redistribuicaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"sem dados internos da SAGA\", () => pm.expect(r).to.not.have.any.keys(\"reservationId\", \"logisticsId\", \"lastEvent\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Diagnóstico no Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/redistributions/{{redistribuicaoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"sagaState LOGISTICS_SCHEDULED\", () => pm.expect(r.sagaState).to.eql(\"LOGISTICS_SCHEDULED\"));",
                  "pm.test(\"correlation id da requisição original\", () => pm.expect(r.correlationId).to.eql(\"postman-saga-ok\"));",
                  "pm.collectionVariables.set(\"logisticaId\", r.logisticsId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar coleta (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/logistics/{{logisticaId}}/collection"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Portal: em trânsito",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/redistributions/{{redistribuicaoId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// o evento logistics.food.collected leva a SAGA a IN_TRANSIT",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"IN_TRANSIT\", () => pm.expect(pm.response.json().status).to.eql(\"IN_TRANSIT\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar entrega (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/logistics/{{logisticaId}}/delivery"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: concluída",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/redistributions/{{redistribuicaoId}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// o evento logistics.food.delivered conclui a SAGA",
                  "setTimeout(() => {}, 2000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"COMPLETED\", () => pm.expect(pm.response.json().sagaState).to.eql(\"COMPLETED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. SAGA (falha, com o logistics parado)",
      "description": "Antes da pasta: docker compose stop logistics-service. Depois: docker compose start logistics-service.",
      "item": [
        {
          "name": "Publicar oferta para a falha",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodCategory\": \"FRUITS\",\n  \"description\": \"Frutas da estação\",\n  \"quantity\": 30,\n  \"unit\": \"KG\",\n  \"availableFrom\": \"{{inicio}}\",\n  \"availableUntil\": \"{{fim}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = n => String(n).padStart(2, \"0\");",
                  "const iso = d => { const off = -d.getTimezoneOffset(), a = Math.abs(off);",
                  "  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}${off >= 0 ? \"+\" : \"-\"}${pad(Math.floor(a / 60))}:${pad(a % 60)}`; };",
                  "const agora = new Date();",
                  "pm.collectionVariables.set(\"inicio\", iso(agora));",
                  "pm.collectionVariables.set(\"fim\", iso(new Date(agora.getTime() + 6 * 3600 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ofertaFalhaId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar redistribuição: FAILED",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-saga-falha"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/redistributions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"offerId\": \"{{ofertaFalhaId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Rode com o logistics-service parado: a SAGA reserva a oferta, não consegue agendar a coleta e libera a reserva."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.test(\"FAILED\", () => pm.expect(r.status).to.eql(\"FAILED\"));",
                  "pm.test(\"problema em linguagem simples\", () => pm.expect(r.problem).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"redistribuicaoFalhaId\", r.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: compensação executada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/redistributions/{{redistribuicaoFalhaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"compensation DONE\", () => pm.expect(r.compensation).to.eql(\"DONE\"));",
                  "pm.test(\"motivo visível\", () => pm.expect(r.failureReason).to.include(\"compensação executada\"));",
                  "pm.test(\"oferta AVAILABLE de novo\", () => pm.expect(r.offer.status).to.eql(\"AVAILABLE\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin: falhas da SAGA",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/admin/v1/redistributions?status=FAILED"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"lista só FAILED\", () => pm.response.json().items.forEach(r => pm.expect(r.sagaState).to.eql(\"FAILED\")));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Outbox (RabbitMQ parado)",
      "description": "1) docker compose stop rabbitmq; 2) rode as duas primeiras; 3) docker compose start rabbitmq; 4) espere uns 20 s e rode a última.",
      "item": [
        {
          "name": "Publicar oferta com o RabbitMQ parado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodCategory\": \"VEGETABLES\",\n  \"description\": \"Cenouras e beterrabas\",\n  \"quantity\": 30,\n  \"unit\": \"KG\",\n  \"availableFrom\": \"{{inicio}}\",\n  \"availableUntil\": \"{{fim}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "A oferta e o evento são gravados na mesma transação; o evento fica PENDING em outbox_events."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const pad = n => String(n).padStart(2, \"0\");",
                  "const iso = d => { const off = -d.getTimezoneOffset(), a = Math.abs(off);",
                  "  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}${off >= 0 ? \"+\" : \"-\"}${pad(Math.floor(a / 60))}:${pad(a % 60)}`; };",
                  "const agora = new Date();",
                  "pm.collectionVariables.set(\"inicio\", iso(agora));",
                  "pm.collectionVariables.set(\"fim\", iso(new Date(agora.getTime() + 6 * 3600 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"ofertaOutboxId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Ainda fora do modelo de leitura",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers?category=VEGETABLES&size=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const oferta = pm.response.json().items.find(o => o.id === pm.collectionVariables.get(\"ofertaOutboxId\"));",
                  "pm.test(\"o evento ainda não saiu\", () => pm.expect(oferta).to.be.undefined);"
                ]
              }
            }
          ]
        },
        {
          "name": "Depois de religar o RabbitMQ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/offers?category=VEGETABLES&size=100",
            "description": "Confira também no banco: docker compose exec offer-db psql -U ravita -d offer_db -c \"select status from outbox_events order by created_at desc limit 3\""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const oferta = pm.response.json().items.find(o => o.id === pm.collectionVariables.get(\"ofertaOutboxId\"));",
                  "pm.test(\"o publicador entregou o evento pendente\", () => pm.expect(oferta).to.be.an(\"object\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. LLM",
      "item": [
        {
          "name": "Pergunta com RAG e tool",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "postman-llm"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/assistant/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Tenho iogurtes que vencem em 3 dias. Posso doar? Quais instituições de Lavras recebem laticínios?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"resposta do modelo\", () => pm.expect(r.mode).to.eql(\"llm\"));",
                  "pm.test(\"fontes da base\", () => pm.expect(r.sources.length).to.be.above(0));",
                  "pm.test(\"usou a tool instituicoes_que_aceitam\", () => pm.expect(r.consultedData.map(c => c.tool)).to.include(\"instituicoes_que_aceitam\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pergunta sobre ofertas (tool do modelo de leitura)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{instituicaoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/assistant/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"O que há de hortaliças disponível em Lavras agora?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"usou buscar_ofertas_disponiveis\", () => pm.expect(pm.response.json().consultedData.map(c => c.tool)).to.include(\"buscar_ofertas_disponiveis\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Fallback (com a chave inválida)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/assistant/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Uma refeição pronta pode ficar quanto tempo aquecida?\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Antes: $env:GOOGLE_API_KEY='invalida'; docker compose up -d assistant-service. Rode 4 vezes: na 4ª o aviso fala em circuito aberto. Depois: Remove-Item Env:GOOGLE_API_KEY; docker compose up -d assistant-service."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"fallback\", () => pm.expect(r.mode).to.eql(\"fallback\"));",
                  "pm.test(\"trechos da base no fallback\", () => pm.expect(r.answer).to.include(\"6 horas\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: pergunta vazia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doadorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/portal/v1/assistant/questions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \" \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 INVALID_REQUEST\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_REQUEST\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
