{
  "info": {
    "name": "Ravita - Pelo gateway",
    "description": "Todas as chamadas passam pelo API Gateway (http://localhost:8000), como um cliente real: tokens, Portal BFF e Admin BFF. Os tokens e os ids ficam nas variáveis da coleção. No Runner, rode as pastas 1 a 5 e 8 (menos a requisição de fallback); as pastas 6 e 7 e o fallback pedem um passo manual, descrito em cada uma.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticação",
      "description": "O gateway emite e valida os tokens (JWT HS256). Sem token: 401. Papel errado: 403.",
      "item": [
        {
          "name": "Token de ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json();",
                  "pm.test(\"tokenType Bearer\", () => pm.expect(t.tokenType).to.eql(\"Bearer\"));",
                  "pm.collectionVariables.set(\"adminToken\", t.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: papel inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/token",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"HACKER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 INVALID_ROLE\", () => {",
                  "    pm.response.to.have.status(400);",
                  "    pm.expect(pm.response.json().code).to.eql(\"INVALID_ROLE\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: sem token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/portal/v1/offers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"401 UNAUTHENTICATED\", () => {",
                  "    pm.response.to.have.status(401);",
                  "    pm.expect(pm.response.json().code).to.eql(\"UNAUTHENTICATED\");",
                  "});",
                  "pm.test(\"correlation id na resposta\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Erro: API dos serviços não é publicada",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/offers",
            "description": "O gateway só encaminha /portal/v1 e /admin/v1. Qualquer outra rota é negada, mesmo com token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"403 FORBIDDEN\", () => {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().code).to.eql(\"FORBIDDEN\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
